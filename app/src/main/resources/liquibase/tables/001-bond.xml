<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.4.xsd">

    <changeSet id="INVEST-001-create-bond-table" author="d.v.kornilovich">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="bond"/>
            </not>
        </preConditions>

        <createTable tableName="bond">
            <column autoIncrement="true" name="id" type="bigserial">
                <constraints primaryKey="true"/>
            </column>
            <column name="ticker" type="varchar2(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="uid" type="varchar2(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="isin" type="varchar2(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="varchar2(100)">
                <constraints nullable="false"/>
            </column>
            <column name="sector" type="varchar2(100)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="varchar2(3)">
                <constraints nullable="false"/>
            </column>
            <column name="maturity_date" type="timestamp"/>
            <column name="risk_level" type="varchar(50)"/>
            <column name="created_at" type="timestamp"/>
            <column name="created_by" type="varchar(200)"/>
            <column name="updated_at" type="timestamp"/>
            <column name="updated_by" type="varchar(200)"/>
        </createTable>
    </changeSet>
</databaseChangeLog>
